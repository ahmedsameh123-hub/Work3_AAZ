# انسخ الملف إلى .env وعدّل القيم — Copy to .env and edit.

JWT_SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./trainmate.db

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# API يعيد الرمز في JSON → التطبيق يعرضه (يعمل لأي إيميل حتى لو SMTP فاشل). false للإنتاج الحساس.
EXPOSE_VERIFICATION_CODES=true

# Comma-separated browser origins for CORS (mobile app ignores CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# إرسال الإيميل (ضروري لو عايز الكود يوصل للإيميل فعلاً)
# Email delivery — REQUIRED for codes to arrive in your inbox.
#
# بدون Resend ولا SMTP: الكود يظهر فقط في تيرمنال السيرفر (console).
# Without either: codes are ONLY printed in the server terminal — NOT emailed.
#
# --- خيار A: Resend (موصى به — يشتغل مع أي إيميل للمستخدم، بدون Gmail) ---
# 1) سجّل في https://resend.com وأنشئ API Key من Dashboard → API Keys
# 2) ضع المفتاح هنا. الإرسال الافتراضي من onboarding@resend.dev (مناسب للتجربة).
#    لاحقاً: أضف دومينك في Resend وغيّر RESEND_FROM إلى إيميلك على الدومين.
#
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=TrainMate <onboarding@resend.dev>
#
# --- خيار B: SMTP (أي مزود: Outlook، Hostinger، إلخ — وليس لازم Google) ---
#
# --- Gmail (لو هتستخدمه) ---
# 1) فعّل التحقق بخطوتين على حساب Google
# 2) أنشئ "App Password": https://myaccount.google.com/apppasswords
# 3) استخدم الـ 16 حرف كـ SMTP_PASSWORD (مش كلمة مرور حسابك العادية)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=youraddress@gmail.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# --- Outlook / Hotmail ---
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=you@outlook.com
# SMTP_PASSWORD=your_password
# SMTP_FROM=you@outlook.com
#
ML_MODELS_DIR=
